{
  "name": "waterscope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --config wrangler.dev.toml --port 8787 --persist-to .wrangler/state",
    "d1:migrate": "wrangler d1 migrations apply waterscope --local --config wrangler.dev.toml --persist-to .wrangler/state",
    "d1:migrate:remote": "wrangler d1 migrations apply waterscope --remote",
    "test:api": "node scripts/smoke-api.mjs",
    "ship": "npm run lint && npm run test:api && npm run build && wrangler deploy",
    "build": "vite build",
    "lint": "oxlint",
    "data:hydrology": "python3 scripts/enrich_hydrorivers.py",
    "data:water-bodies": "python3 scripts/overpass_water_to_geojson.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wrangler": "^4.142.0"
  }
}
